using Gtk 4.0;
using Adw 1;

template $BookDetail: Adw.NavigationPage {
  tag: 'book_overview';
  title: bind template.book-title;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton book_menu {
        menu-model: book_menu_model;
        icon-name: "view-more-symbolic";
        tooltip-text: _("Open Book Menu");
      }
    }

    content: Adw.BreakpointBin {
      width-request: 350;
      height-request: 52;

      Adw.Breakpoint {
        condition ("max-width: 550sp")

        setters {
          top_box.orientation: vertical;
          top_box.spacing: 6;
          top_box.halign: center;
          book_label.halign: center;
          author_label.halign: center;
          play_button.halign: center;
        }
      }

      child: Box {
        orientation: vertical;

        Adw.Banner unavailable_banner {
          title: _("Some or all files of this book cannot be found.");
        }

        ScrolledWindow {
          focusable: true;
          vexpand: true;
          hscrollbar-policy: never;
          propagate-natural-width: true;
          propagate-natural-height: true;

          child: Box {
            orientation: vertical;

            Adw.Clamp {
              maximum-size: 800;

              Box top_box {
                orientation: horizontal;
                spacing: 30;
                margin-start: 18;
                margin-end: 18;
                margin-top: 12;
                margin-bottom: 18;
                halign: fill;
                hexpand: true;

                Adw.Clamp {
                  maximum-size: 200;

                  Stack album_art_container {
                    halign: center;
                    width-request: 200;
                    height-request: 200;

                    Picture album_art {
                      content-fit: cover;

                      styles [
                        "book_detail_art",
                      ]
                    }

                    Image fallback_icon {
                      icon-name: "cozy.book-open-symbolic";
                      pixel-size: 200;
                    }

                    styles [
                      "card",
                    ]
                  }
                }

                Box {
                  orientation: vertical;
                  spacing: 6;
                  vexpand: false;


                  Label book_label {
                    halign: start;
                    label: bind template.book_title;
                    ellipsize: end;
                    max-width-chars: 35;
                    lines: 1;

                    styles [
                      "title-1",
                      "bold",
                    ]
                  }

                  Label author_label {
                    halign: start;
                    label: _("Book author");
                    ellipsize: end;
                    max-width-chars: 50;
                    lines: 1;

                    styles [
                      "title-3",
                      "dim-label",
                    ]
                  }

                  ProgressBar book_progress_bar {
                  }

                  Box download_box {
                    orientation: vertical;
                    spacing: 4;
                    halign: fill;
                    margin-top: 6;
                    visible: false;

                    ProgressBar download_progress_bar {
                      halign: fill;
                    }

                    Label download_progress_label {
                      halign: start;
                      styles [
                        "caption",
                        "dim-label",
                      ]
                    }
                  }

                  Box {
                    orientation: horizontal;
                    hexpand: true;
                    halign: fill;

                    Label progress_label {
                      halign: start;
                    }

                    Label total_label{
                      halign: end;
                      hexpand: true;
                      label: _("Loading…");
                    }
                  }


                  Button play_button {
                    halign: start;
                    valign: end;
                    vexpand: true;
                    margin-top: 12;
                    focusable: true;
                    receives-default: true;
                    tooltip-text: _("Start/Stop playback");

                    accessibility {
                      label: _("Start or pause the playback");
                    }

                    styles [
                      "suggested-action",
                      "pill",
                    ]

                    Adw.ButtonContent play_icon {
                      label: _("Start");
                      icon-name: 'media-playback-start-symbolic';
                    }
                  }
                }
              }
            }

            StackSwitcher content_switcher {
              stack: content_stack;
              halign: center;
              margin-start: 18;
              margin-end: 18;
              margin-top: 12;
              visible: false;
            }

            Stack content_stack {
              vexpand: true;

              StackPage {
                name: 'details';
                title: _("Details");

                child: Adw.Clamp {
                  maximum-size: 800;
                  vexpand: true;

                  child: Box details_box {
                    orientation: vertical;
                    spacing: 12;
                    margin-start: 18;
                    margin-end: 18;
                    margin-top: 12;
                    margin-bottom: 24;

                    Label description_label {
                      xalign: 0;
                      wrap: true;
                      wrap-mode: word_char;
                      visible: false;

                      styles [
                        "body",
                      ]
                    }

                    ListBox details_list {
                      selection-mode: none;
                      visible: false;

                      styles [
                        "boxed-list",
                      ]

                      Adw.ActionRow status_row {
                        title: _("Status");
                        visible: false;
                      }

                      Adw.ActionRow series_row {
                        title: _("Series");
                        visible: false;
                      }

                      Adw.ActionRow publisher_row {
                        title: _("Publisher");
                        visible: false;
                      }

                      Adw.ActionRow published_year_row {
                        title: _("Published");
                        visible: false;
                      }

                      Adw.ActionRow language_row {
                        title: _("Language");
                        visible: false;
                      }

                      Adw.ActionRow asin_row {
                        title: _("ISBN / ASIN");
                        visible: false;
                      }
                    }

                  };
                };
              }
              StackPage {
                name: 'chapters';
                title: _("Chapters");

                child: Adw.Clamp {
                  maximum-size: 800;
                  vexpand: true;

                  child: Stack chapters_stack {
                    margin-start: 18;
                    margin-end: 18;
                    margin-top: 12;
                    margin-bottom: 24;

                    StackPage {
                      name: 'chapters_wrapper';

                      child: Box chapter_list_container {
                        orientation: vertical;
                        spacing: 18;
                      };
                    }

                    StackPage {
                      name: 'chapters_loader';

                      child: Adw.StatusPage _loading_status_page {
                        paintable: Adw.SpinnerPaintable {
                          widget: _loading_status_page;
                        };
                        title: _("Loading…");
                      };
                    }
                  };
                };
              }

            }
          };
        }
      };
    };
  }
}

menu book_menu_model {
  section {
    item {
      action: 'book_overview.download';
      label: _("_Available Offline");
      hidden-when: "action-disabled";
    }
  }

  section menu_section {}
}
